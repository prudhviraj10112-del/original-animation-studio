# Backend Configuration
NODE_ENV=development
PORT=5000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_TYPE=json
# DATABASE_TYPE=postgres (for future migration)
# DATABASE_URL=postgresql://user:password@localhost:5432/animation_studio

# Video Provider Configuration
VIDEO_PROVIDER=mock
# VIDEO_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Image Provider Configuration
IMAGE_PROVIDER=mock
# IMAGE_PROVIDER=openai

# Voice Provider Configuration
VOICE_PROVIDER=mock
# ELEVENLABS_API_KEY=...

# Logging
LOG_LEVEL=info